# --- Required -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id (e.g. from @userinfobot). The API rejects
# every request that isn't signed as this user.
OWNER_TELEGRAM_ID=
# The deployed Mini App frontend's origin, e.g. https://shadowscout.vercel.app
MINIAPP_ORIGIN=
# Public HTTPS URL the bot points its menu button at, usually the same origin.
MINIAPP_URL=

SHADOWSCOUT_DB=shadowscout.db

# Optional: encrypts API keys saved in the app. If empty, one is generated on first
# use and kept in a private file beside the database. Changing it means re-entering keys.
SHADOWSCOUT_SECRET_KEY=

# --- Keys: paste these in the app's Settings instead ----------------------
# A key set here still works, and one saved in the app overrides it.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
FOOTBALL_DATA_TOKEN=
STRIKERAPI_API_KEY=
API_FOOTBALL_KEY=
ODDS_API_KEY=

LLM_PROVIDER=claude
# Comma-separated, tried in order only when LLM_PROVIDER hits a rate limit or
# exhausted quota, e.g. "groq,gemini". Empty (default): no fallback.
LLM_FALLBACK_PROVIDERS=
MIN_MODEL_PROBABILITY=0

# --- Market ---------------------------------------------------------------
BOOKMAKER_ADAPTER=polymarket

# Only for BOOKMAKER_ADAPTER=the_odds_api -------------------------------------
# De-vig method for the fair-price baseline: proportional (default) or shin
# (corrects favorite-longshot bias, see odds.py).
DEVIG_METHOD=proportional
# Optional: use this bookmaker's own de-vigged price instead of the cross-book
# median (e.g. pinnacle). Confirm the key exists in your Odds API response first.
REFERENCE_BOOKMAKER=
# Minimum bookmakers required to quote a market before a pick on it is trusted
# (ignored when REFERENCE_BOOKMAKER is set).
MIN_BOOKS_FOR_PICK=2
# The Odds API's own key for the book in BOOKMAKER_SITE. Its namespace differs
# (it may call "leon" "leonbets"), so verify against a live response.
EXECUTION_BOOKMAKER=

# --- Opening a bookmaker's site (optional) --------------------------------
# 1xbet | fonbet | bet365 | leon | winline. Opened, logged in via your own manual
# login, when you tap "Ставлю" in the bot. See browser_session.py.
BOOKMAKER_SITE=leon
# Shared secret for extension/, which runs on the bookmaker's own site and so
# can't use Telegram initData. Generate with
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Unset (default): the extension's API routes are disabled.
EXTENSION_API_TOKEN=
