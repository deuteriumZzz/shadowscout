TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Optional — without these the bot still works, Claude just web-searches
# odds/stats itself instead of pulling structured numbers.
ODDS_API_KEY=
API_FOOTBALL_KEY=

BOOKMAKER_ADAPTER=the_odds_api
# 1xbet | fonbet | bet365 | leon | winline — opened (logged in via your own
# manual login) when you tap "Ставлю". See browser_session.py.
BOOKMAKER_SITE=leon
LLM_PROVIDER=claude
GROQ_API_KEY=
GEMINI_API_KEY=
# Comma-separated, tried in order only when LLM_PROVIDER hits a rate limit or
# exhausted quota — e.g. "groq,gemini". Empty (default): no fallback.
LLM_FALLBACK_PROVIDERS=
MIN_MODEL_PROBABILITY=0
SHADOWSCOUT_DB=shadowscout.db

# De-vig method for the fair-price baseline: proportional (default) or shin
# (corrects favorite-longshot bias, see odds.py).
DEVIG_METHOD=proportional
# Optional: use this bookmaker's own de-vigged price instead of the
# cross-book median (e.g. pinnacle) — only set it once you've confirmed
# that key is actually present in your own Odds API response.
REFERENCE_BOOKMAKER=
# Minimum bookmakers required to quote a market before a pick on it is
# trusted (ignored when REFERENCE_BOOKMAKER is set).
MIN_BOOKS_FOR_PICK=2

# The Odds API's own key for whichever book BOOKMAKER_SITE points to (its
# namespace differs — e.g. Odds API may call it "leonbets", not "leon").
# Verify against a live API response before setting this. When set, the
# кэф shown/recorded is that book's own price, not an unverified
# best-of-market composite you might not actually be able to get.
EXECUTION_BOOKMAKER=

# Shared secret for extension/ (bet-slip auto-fill browser extension) — it
# runs on the bookmaker's own site, outside Telegram, so it authenticates
# with this bearer token instead of Telegram initData. Generate with
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`.
# Unset (default): the extension's API routes are disabled.
EXTENSION_API_TOKEN=

# --- Telegram Mini App (webapp_api/, miniapp/) --------------------------
# Your own numeric Telegram user id (e.g. from @userinfobot) — the API
# rejects every request that isn't signed as this user, no matter how
# valid the Telegram signature otherwise looks.
OWNER_TELEGRAM_ID=
# The deployed Mini App frontend's origin, e.g. https://shadowscout.vercel.app
MINIAPP_ORIGIN=
# Public HTTPS URL bot.py points its menu button at — usually the same
# origin as MINIAPP_ORIGIN.
MINIAPP_URL=
